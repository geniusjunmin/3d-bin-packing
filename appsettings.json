{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PackingAlgorithm": {
    "SearchMode": "Balanced",
    "EarlyStageThreshold": 0.65,
    "WasteWeight": 7.0,
    "ContactWeight": 1.5,
    "EnvelopeWeight": 2.5,
    "HeightWeight": 1.0,
    "FragmentationWeight": 2.0,
    "FutureFitWeight": 4.0,
    "SupportWeight": 0.25,
    "MinimumSupportRatio": 0.90,
    "MinimumQuadrantSupportRatio": 0.70,
    "DifficultyTopK": 10,
    "MaxExtremePoints": 160,
    "MaxEmptySpaces": 128,
    "BeamWidth": 4,
    "BranchFactor": 4,
    "LookaheadDepth": 2,
    "MemoizationCapacity": 4096,
    "TimeBudgetMs": 250,
    "EnableBeamSearch": true,
    "EnableLegacyFallback": true
  },
  "AllowedHosts": "*"
}
